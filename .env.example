# Copia este archivo a .env (el .env nunca se sube). Lo carga application.properties.
# El gateway no tiene base de datos ni secretos propios por ahora.

GATEWAY_PORT=8080

# Dónde está cada servicio
IAM_URL=http://localhost:3001
FLEET_URL=http://localhost:3002
BOOKING_URL=http://localhost:3003
PAYMENT_URL=http://localhost:3004
TELEMETRY_URL=http://localhost:3005

# Orígenes del frontend que pueden llamar al gateway (separados por coma). 5173 = Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173
