# Copia este archivo a .env (el .env nunca se sube). Lo carga application.properties.
# El gateway no tiene base de datos ni secretos propios por ahora.

GATEWAY_PORT=8080

# Dónde está cada servicio
IAM_URL=http://localhost:3001
FLEET_URL=http://localhost:3002
BOOKING_URL=http://localhost:3003
PAYMENT_URL=http://localhost:3004
TELEMETRY_URL=http://localhost:3005

# Rate limiting (security-rules.md: 10 intentos de login por IP cada 5 min)
RATE_LIMIT_SENSITIVE_LIMIT=10
RATE_LIMIT_SENSITIVE_WINDOW=5m
RATE_LIMIT_GENERAL_LIMIT=100
RATE_LIMIT_GENERAL_WINDOW=1m

# Orígenes del frontend que pueden llamar al gateway (separados por coma). 5173 = Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Clave PÚBLICA RS256 de iam. Texto base64 del PEM en una sola línea. Es la MISMA que
# APP_IAM_JWT_PUBLIC_KEY del .env de rtm-iam, no una nueva.
APP_GATEWAY_JWT_PUBLIC_KEY=
